}
}
# Para cada modelo e n, agrega os erros dos horizontes 1:n em todas as origens.
resultados <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
do.call(rbind, lapply(n_valores, function(n) {
e <- erros[m, , seq_len(n), drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
n = n,
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
}))
resultados <- resultados[order(resultados$n, resultados$RMSE), ]
print(resultados, row.names = FALSE)
write.csv(resultados, "data/processed/sarima_cv_por_n.csv", row.names = FALSE)
grafico <- ggplot(resultados, aes(x = n, y = RMSE, color = modelo, group = modelo)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "SARIMA: RMSE de validacao cruzada por horizonte n",
subtitle = "p e q entre 1 e 2; seis ordens sazonais candidatas",
x = "Horizonte n (meses)",
y = "RMSE",
color = "Modelo"
) +
theme_minimal()
print(grafico)
comparacao_geral <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
e <- erros[m, , , drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
comparacao_geral <- comparacao_geral[
order(comparacao_geral$RMSE),
]
print(comparacao_geral, row.names = FALSE)
# ============================================================
# SÉRIE TEMPORAL - INADIMPLÊNCIA NO BRASIL
# BUSCA E ANÁLISE DE MODELOS SARIMA
# ============================================================
# ------------------------------------------------------------
# 0. Preparação
# ------------------------------------------------------------
rm(list = ls())
library(dplyr)
library(ggplot2)
library(forecast)
library(tseries)
serie_inadp <- read.csv(
"data/processed/serie_temporal_inadimplencia_filtered.csv",
sep = ",",
header = TRUE
)
# Série mensal, conforme definido na análise inicial (R/01_series_analysis.R).
ts_serie <- ts(
serie_inadp$y,
start = c(2011, 3),
frequency = 12
)
# ============================================================
# 1. SEPARAÇÃO ENTRE TREINO E TESTE
# ============================================================
# n=40 - SARIMA(1,2,2)(2,2,2)[3]
# n=32 - SARIMA(1,2,2)(2,2,2)[3]
# n=24 - SARIMA(1,2,2)(0,3,1)[6]
# n=18 - SARIMA(2,2,1)(1,2,0)[6]
n_teste <- 36
n_total <- length(ts_serie)
n_treino <- n_total - n_teste
serie_treino <- window(
ts_serie,
end = time(ts_serie)[n_treino]
)
serie_teste <- window(
ts_serie,
start = time(ts_serie)[n_treino + 1]
)
autoplot(serie_treino, series = "Treino") +
autolayer(serie_teste, series = "Teste") +
labs(
title = "1.1 - Separação entre treino e teste",
x = "Ano",
y = "Inadimplência"
) +
theme_minimal()
# ============================================================
# 2. BUSCA DE MODELOS SARIMA
# ============================================================
# Modelo: SARIMA(p, 2, q)(P, D, Q)[s]. Os termos não sazonais p e q,
# sazonais P, D e Q variam de 0 a 3; os períodos sazonais são 3, 6 e 12.
# A diferenciação não sazonal d permanece fixa em 2.
ordens_sarima <- expand.grid(
p = 1:2,
q = 1:2,
P = 0:2,
D = 0:2,
Q = 0:2,
s = c(3, 6)
)
ordens_sarima$nome <- with(
ordens_sarima,
sprintf("SARIMA(%d,2,%d)(%d,%d,%d)[%d]", p, q, P, D, Q, s)
)
ajustar_sarima <- function(p, q, P, D, Q, s) {
tryCatch(
forecast::Arima(
serie_treino,
order = c(p, 2, q),
seasonal = list(order = c(P, D, Q), period = s),
include.drift = FALSE,
method = "ML"
),
error = function(e) NULL
)
}
modelos <- setNames(
lapply(seq_len(nrow(ordens_sarima)), function(i) {
ajustar_sarima(
ordens_sarima$p[i],
ordens_sarima$q[i],
ordens_sarima$P[i],
ordens_sarima$D[i],
ordens_sarima$Q[i],
ordens_sarima$s[i]
)
}),
ordens_sarima$nome
)
# Remove candidatos que não puderam ser estimados.
modelos <- modelos[!vapply(modelos, is.null, logical(1))]
# ============================================================
# 3. AVALIAÇÃO E COMPARAÇÃO
# ============================================================
avaliar_modelo <- function(modelo, nome) {
previsao <- forecast(modelo, h = n_teste)
valores_reais <- as.numeric(serie_teste)
valores_previstos <- as.numeric(previsao$mean)
erros <- valores_reais - valores_previstos
data.frame(
modelo = nome,
AIC = AIC(modelo),
BIC = BIC(modelo),
RMSE = sqrt(mean(erros^2))
)
}
resultados <- bind_rows(lapply(names(modelos), function(nome) {
avaliar_modelo(modelos[[nome]], nome)
}))
resultados_rmse <- resultados |>
arrange(RMSE)
print(resultados_rmse)
# ============================================================
# 4. SELEÇÃO E PREVISÃO DO MELHOR MODELO
# ============================================================
melhor_nome <- "SARIMA(1,2,2)(2,2,2)[3]"
melhor_modelo <- Arima(ts_serie,
order = c(1, 2, 2),
seasonal = list(order = c(2, 2, 2),
period = 3)
)
previsao_teste <- forecast(melhor_modelo, h = n_teste)
erro_melhor_modelo <- as.numeric(serie_teste) - as.numeric(previsao_teste$mean)
RMSE_melhor_modelo = sqrt(mean(erro_melhor_modelo^2))
cat("Modelo com menor RMSE no teste:", melhor_nome, "\n")
cat("RMSE no teste:", RMSE_melhor_modelo, "\n")
summary(melhor_modelo)
autoplot(previsao_teste) +
autolayer(serie_teste, series = "Valores observados") +
labs(
title = paste("4.1 - Previsões no teste:", melhor_nome),
x = "Ano",
y = "Inadimplência"
) +
theme_minimal()
# ============================================================
# 5. ANÁLISE DOS RESÍDUOS DO MELHOR MODELO
# ============================================================
residuos <- residuals(melhor_modelo)
autoplot(residuos) +
labs(
title = paste("5.1 - Resíduos do modelo", melhor_nome),
x = "Ano",
y = "Resíduo"
) +
theme_minimal()
acf(
residuos,
lag.max = 36,
main = "5.2 - ACF dos resíduos"
)
# Diagnóstico gráfico e teste de Ljung-Box para autocorrelação residual.
checkresiduals(melhor_modelo)
# Avaliação da normalidade dos resíduos (Shapiro-Wilk aceita até 5.000 valores).
residuos_validos <- as.numeric(na.omit(residuos))
if (length(residuos_validos) >= 3 && length(residuos_validos) <= 5000) {
print(shapiro.test(residuos_validos))
} else {
message("O teste de Shapiro-Wilk requer entre 3 e 5.000 resíduos válidos.")
}
qqnorm(residuos_validos, main = "5.3 - Gráfico Q-Q dos resíduos")
qqline(residuos_validos, col = "red")
# Critérios de informação do modelo selecionado.
cat("AIC do melhor modelo:", AIC(melhor_modelo), "\n")
cat("BIC do melhor modelo:", BIC(melhor_modelo), "\n")
# ------------------------------------------------------------
# 6 PREVISÃO FUTURA
# ------------------------------------------------------------
h_futuro <- 24
previsao_futura <- forecast(
melhor_modelo,
h = h_futuro
)
# ------------------------------------------------------------
# 6.1 Gráfico da previsão
# ------------------------------------------------------------
autoplot(
previsao_futura
) +
autolayer(
ts_serie,
series = "Observado"
) +
labs(
title = paste(
"6.1 - Previsão futura:",
melhor_nome
),
x = "Tempo",
y = "Inadimplência",
colour = NULL,
fill = NULL
) +
theme_minimal()
# ============================================================
# VALIDACAO CRUZADA TEMPORAL SARIMA: HORIZONTES E ORDENS SAZONAIS
# ============================================================
rm(list = ls())
library(forecast)
library(ggplot2)
serie_inadp <- read.csv(
"data/processed/serie_temporal_inadimplencia_filtered.csv",
sep = ",",
header = TRUE
)
ts_serie <- ts(serie_inadp$y, start = c(2011, 3), frequency = 12)
# Horizontes discretos no intervalo inclusivo 12 <= n <= 36.
n_valores <- seq(12, 36, by = 4)
h_max <- max(n_valores)
# No maximo quatro origens para limitar o tempo: com as grades abaixo,
# serao ate 4 x 7 x 4 = 112 ajustes.
initial <- min(60, length(ts_serie) - h_max)
max_origens <- 4
passo_origens <- max(1, floor((length(ts_serie) - initial - h_max) /
max(1, max_origens - 1)))
if (initial < 30) {
stop("Serie curta demais para initial >= 30 e o horizonte maximo escolhido.")
}
origens <- seq(initial, length(ts_serie) - h_max, by = passo_origens)
if (length(origens) > max_origens) origens <- tail(origens, max_origens)
if (length(origens) == 0) {
stop("Nao ha observacoes suficientes para os horizontes definidos.")
}
# Grade sazonal reduzida: sete candidatos, em periodos 3 e 6.
# Cada linha representa (P, D, Q)[periodo].
ordens_sazonais <- data.frame(
P = c(0, 1, 2, 0, 0, 1, 2),
D = c(1, 1, 2, 2, 1, 1, 2),
Q = c(1, 1, 2, 1, 1, 1, 2),
periodo = c(3, 3, 3, 3, 6, 6, 6)
)
# p e q nao sazonais variam independentemente entre 1 e 2.
grade_modelos <- merge(
expand.grid(p = 1:2, q = 1:2),
ordens_sazonais,
by = NULL
)
grade_modelos$modelo <- with(
grade_modelos,
sprintf("SARIMA(%d,2,%d)(%d,%d,%d)[%d]", p, q, P, D, Q, periodo)
)
erros <- array(
NA_real_,
dim = c(nrow(grade_modelos), length(origens), h_max),
dimnames = list(
modelo = grade_modelos$modelo,
origem = paste0("origem_", origens),
horizonte = paste0("h", seq_len(h_max))
)
)
total_ajustes <- nrow(grade_modelos) * length(origens)
contador_ajustes <- 0L
for (m in seq_len(nrow(grade_modelos))) {
for (i in seq_along(origens)) {
fim_treino <- origens[i]
treino <- ts_serie[seq_len(fim_treino)]
observado <- as.numeric(ts_serie[(fim_treino + 1):(fim_treino + h_max)])
ajuste <- tryCatch(
forecast::Arima(
treino,
order = c(grade_modelos$p[m], 2, grade_modelos$q[m]),
seasonal = list(
order = c(grade_modelos$P[m], grade_modelos$D[m], grade_modelos$Q[m]),
period = grade_modelos$periodo[m]
),
include.drift = FALSE,
method = "ML"
),
error = function(e) {
message("Falha em ", grade_modelos$modelo[m], " na origem ",
fim_treino, ": ", conditionMessage(e))
NULL
}
)
if (!is.null(ajuste)) {
previsto <- forecast(ajuste, h = h_max)$mean
erros[m, i, ] <- observado - as.numeric(previsto)
}
contador_ajustes <- contador_ajustes + 1L
message("Ajuste ", contador_ajustes, "/", total_ajustes,
" concluido: ", grade_modelos$modelo[m],
", origem ", fim_treino, ".")
}
}
# Para cada modelo e n, agrega os erros dos horizontes 1:n em todas as origens.
resultados <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
do.call(rbind, lapply(n_valores, function(n) {
e <- erros[m, , seq_len(n), drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
n = n,
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
}))
resultados <- resultados[order(resultados$n, resultados$RMSE), ]
print(resultados, row.names = FALSE)
write.csv(resultados, "data/processed/sarima_cv_por_n.csv", row.names = FALSE)
grafico <- ggplot(resultados, aes(x = n, y = RMSE, color = modelo, group = modelo)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "SARIMA: RMSE de validacao cruzada por horizonte n",
subtitle = "p e q entre 1 e 2; sete ordens sazonais candidatas",
x = "Horizonte n (meses)",
y = "RMSE",
color = "Modelo"
) +
theme_minimal()
print(grafico)
comparacao_geral <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
e <- erros[m, , , drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
comparacao_geral <- comparacao_geral[
order(comparacao_geral$RMSE),
]
print(comparacao_geral, row.names = FALSE)
# ============================================================
# VALIDACAO CRUZADA TEMPORAL SARIMA: HORIZONTES E ORDENS SAZONAIS
# ============================================================
rm(list = ls())
library(forecast)
library(ggplot2)
serie_inadp <- read.csv(
"data/processed/serie_temporal_inadimplencia_filtered.csv",
sep = ",",
header = TRUE
)
ts_serie <- ts(serie_inadp$y, start = c(2011, 3), frequency = 12)
# Horizontes discretos no intervalo inclusivo 12 <= n <= 36.
n_valores <- seq(12, 36, by = 4)
h_max <- max(n_valores)
# No maximo quatro origens para limitar o tempo: com as grades abaixo,
# serao ate 4 x 7 x 4 = 112 ajustes.
initial <- min(60, length(ts_serie) - h_max)
max_origens <- 4
passo_origens <- max(1, floor((length(ts_serie) - initial - h_max) /
max(1, max_origens - 1)))
if (initial < 30) {
stop("Serie curta demais para initial >= 30 e o horizonte maximo escolhido.")
}
origens <- seq(initial, length(ts_serie) - h_max, by = passo_origens)
if (length(origens) > max_origens) origens <- tail(origens, max_origens)
if (length(origens) == 0) {
stop("Nao ha observacoes suficientes para os horizontes definidos.")
}
# Grade sazonal reduzida: sete candidatos, em periodos 3 e 6.
# Cada linha representa (P, D, Q)[periodo].
ordens_sazonais <- data.frame(
P = c(0, 1, 2, 0, 0, 1, 2),
D = c(1, 1, 2, 2, 1, 1, 2),
Q = c(1, 1, 2, 1, 1, 1, 2),
periodo = c(3, 3, 3, 3, 6, 6, 6)
)
# p e q nao sazonais variam independentemente entre 1 e 2.
grade_modelos <- merge(
expand.grid(p = 1:2, q = 1:2),
ordens_sazonais,
by = NULL
)
grade_modelos$modelo <- with(
grade_modelos,
sprintf("SARIMA(%d,2,%d)(%d,%d,%d)[%d]", p, q, P, D, Q, periodo)
)
erros <- array(
NA_real_,
dim = c(nrow(grade_modelos), length(origens), h_max),
dimnames = list(
modelo = grade_modelos$modelo,
origem = paste0("origem_", origens),
horizonte = paste0("h", seq_len(h_max))
)
)
total_ajustes <- nrow(grade_modelos) * length(origens)
contador_ajustes <- 0L
for (m in seq_len(nrow(grade_modelos))) {
for (i in seq_along(origens)) {
fim_treino <- origens[i]
treino <- ts_serie[seq_len(fim_treino)]
observado <- as.numeric(ts_serie[(fim_treino + 1):(fim_treino + h_max)])
ajuste <- tryCatch(
forecast::Arima(
treino,
order = c(grade_modelos$p[m], 2, grade_modelos$q[m]),
seasonal = list(
order = c(grade_modelos$P[m], grade_modelos$D[m], grade_modelos$Q[m]),
period = grade_modelos$periodo[m]
),
include.drift = FALSE,
method = "ML"
),
error = function(e) {
message("Falha em ", grade_modelos$modelo[m], " na origem ",
fim_treino, ": ", conditionMessage(e))
NULL
}
)
if (!is.null(ajuste)) {
previsto <- forecast(ajuste, h = h_max)$mean
erros[m, i, ] <- observado - as.numeric(previsto)
}
contador_ajustes <- contador_ajustes + 1L
message("Ajuste ", contador_ajustes, "/", total_ajustes,
" concluido: ", grade_modelos$modelo[m],
", origem ", fim_treino, ".")
}
}
# Para cada modelo e n, agrega os erros dos horizontes 1:n em todas as origens.
resultados <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
do.call(rbind, lapply(n_valores, function(n) {
e <- erros[m, , seq_len(n), drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
n = n,
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
}))
# Mantem todos os resultados na tabela, mas plota apenas os cinco modelos
# com menor RMSE geral, agregando os horizontes e origens da validacao.
rmse_geral <- data.frame(
modelo = grade_modelos$modelo,
RMSE_geral = vapply(seq_len(nrow(grade_modelos)), function(m) {
sqrt(mean(erros[m, , ]^2, na.rm = TRUE))
}, numeric(1))
)
resultados <- resultados[order(resultados$n, resultados$RMSE), ]
print(resultados, row.names = FALSE)
write.csv(resultados, "data/processed/sarima_cv_por_n.csv", row.names = FALSE)
top5_modelos <- head(rmse_geral$modelo[order(rmse_geral$RMSE_geral)], 5)
resultados_grafico <- subset(resultados, modelo %in% top5_modelos)
grafico <- ggplot(resultados_grafico, aes(x = n, y = RMSE, color = modelo, group = modelo)) +
geom_line() +
geom_point(size = 2) +
labs(
title = "SARIMA: RMSE de validacao cruzada por horizonte n",
subtitle = "p e q entre 1 e 2; sete ordens sazonais candidatas",
x = "Horizonte n (meses)",
y = "RMSE",
color = "Modelo"
) +
theme_minimal()
print(grafico)
comparacao_geral <- do.call(rbind, lapply(seq_len(nrow(grade_modelos)), function(m) {
e <- erros[m, , , drop = FALSE]
data.frame(
modelo = grade_modelos$modelo[m],
RMSE = sqrt(mean(e^2, na.rm = TRUE)),
MAE = mean(abs(e), na.rm = TRUE),
previsoes_validas = sum(!is.na(e))
)
}))
comparacao_geral <- comparacao_geral[
order(comparacao_geral$RMSE),
]
print(comparacao_geral, row.names = FALSE)
